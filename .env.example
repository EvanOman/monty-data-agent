ANTHROPIC_API_KEY=sk-ant-...your-key-here

# Pydantic AI mode (default model: openai:gpt-5.4)
OPENAI_API_KEY=sk-...your-openai-key-here

# Kimi K2.6 mode — Moonshot platform (default model: moonshotai:kimi-k2.6)
# Get a key at https://platform.kimi.ai
MOONSHOTAI_API_KEY=sk-...your-moonshot-key-here

# LLM Gateway routing (opt-in). Set BOTH to route Anthropic SDK and pydantic-ai
# OpenAI clients through a LiteLLM gateway; leave BOTH unset for direct provider
# access (no behavior change). Does NOT affect the Moonshot/Kimi path.
# Anthropic SDK base_url has trailing /v1 stripped; pydantic-ai OpenAI uses it as-is.
# LLM_GATEWAY_BASE_URL=http://localhost:18400/v1
# LLM_GATEWAY_API_KEY=GATEWAY_KEY_PLACEHOLDER
